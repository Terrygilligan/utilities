rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Community tool ratings — anonymous read, constrained anonymous write.
    // Docs: { ratingSum: int, ratingCount: int, updatedAt: timestamp }
    // averageScore is derived client-side as ratingSum / ratingCount.
    match /tool_ratings/{toolId} {
      allow read: if true;

      // First rating for a tool: exactly {1..5} sum, count == 1.
      allow create: if request.resource.data.keys().hasOnly(['ratingSum', 'ratingCount', 'updatedAt'])
        && request.resource.data.ratingCount == 1
        && request.resource.data.ratingSum is int
        && request.resource.data.ratingSum >= 1
        && request.resource.data.ratingSum <= 5;

      // Subsequent writes only via increment() transforms:
      //  - new vote:   count +1, sum +1..5
      //  - re-vote:    count unchanged, sum delta -4..4 (changing a previous rating)
      allow update: if request.resource.data.diff(resource.data).changedKeys()
            .hasOnly(['ratingSum', 'ratingCount', 'updatedAt'])
        && (
          (request.resource.data.ratingCount == resource.data.ratingCount + 1
            && request.resource.data.ratingSum - resource.data.ratingSum >= 1
            && request.resource.data.ratingSum - resource.data.ratingSum <= 5)
          ||
          (request.resource.data.ratingCount == resource.data.ratingCount
            && request.resource.data.ratingSum - resource.data.ratingSum >= -4
            && request.resource.data.ratingSum - resource.data.ratingSum <= 4)
        );

      allow delete: if false;
    }

    // Everything else denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
